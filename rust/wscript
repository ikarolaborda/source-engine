#! /usr/bin/env python
# encoding: utf-8

import os
from waflib import Utils
from waflib.TaskGen import feature

top = '.'

# Library file names for the subprojects the top-level wscript drops for a Rust
# build, which it does on macOS alone. Kept in step with its RUST_MODULES, whose
# keys are directories; these are the names Cargo gives the libraries.
RUST_MODULES = ['inputsystem', 'scenefilecache', 'soundemittersystem', 'steam_api']

# Modules other subprojects link rather than dlopen. `scenefilecache` and
# `soundemittersystem` are found through CreateInterface and named by nobody, so
# dropping their C++ costs the build nothing. `steam_api` is in the `use` of
# eight subprojects, and Waf resolves `use` names to task generators: with the
# C++ one gone there has to be another answering to the name.
RUST_LINKED_MODULES = ['steam_api']

@feature('cargo_link_library')
def bind_cargo_link_library(self):
	'''Lets a subproject keep `use = ['steam_api']` after the C++ module leaves.

	Waf reads three things off the task generator a `use` name resolves to, all
	of them from its link task: the target name to pass as -l, the directory of
	its first output to pass as -L, and the outputs themselves, which it copies
	into the consumer's dep_nodes so the linker is ordered after the producer.
	Cargo's task carries all three, so handing it over is enough; without a task
	generator of this name Waf would fall through to the uselib path and drop
	the library from the link line without saying so.'''
	cargo = self.bld.get_tgen_by_name('rust_engine_workspace')
	cargo.post()
	if len(cargo.tasks) != 1:
		self.bld.fatal('rust_engine_workspace is no longer one task, so there is no '
			'single producer to link %s against' % self.name)
	self.link_task = cargo.tasks[0]
	self.target = self.name

def options(opt):
	return

def configure(conf):
	return

def build(bld):
	target_dir = bld.bldnode.make_node('cargo-target')
	profile_dir = target_dir.make_node('release')

	if bld.env.DEST_OS == 'darwin':
		dynamic_pattern = 'lib%s.dylib'
	elif bld.env.DEST_OS == 'win32':
		dynamic_pattern = '%s.dll'
	else:
		dynamic_pattern = 'lib%s.so'

	abi = profile_dir.make_node(dynamic_pattern % 'source_abi')
	# Engine modules that are Rust alone. Each takes the file name of the C++
	# module it replaces, which the top-level wscript leaves out of the build.
	modules = []
	if bld.env.DEST_OS == 'darwin':
		modules = [profile_dir.make_node(dynamic_pattern % name) for name in RUST_MODULES]
	launcher = None

	outputs = [abi] + modules
	if bld.env.DEST_OS != 'win32':
		outputs.append(profile_dir.make_node('libsource_abi.a'))
	if bld.env.DEST_OS == 'darwin':
		launcher = profile_dir.make_node('source-launcher')
		outputs.append(launcher)

	sources = bld.path.ant_glob('**/*.rs **/Cargo.toml')
	sources.append(bld.srcnode.find_node('Cargo.toml'))
	lock = bld.srcnode.find_node('Cargo.lock')
	if lock:
		sources.append(lock)

	def run_cargo(task):
		cargo = task.env.CARGO[0]
		return task.exec_command([
			cargo,
			'build',
			'--workspace',
			'--release',
			'--target-dir', target_dir.abspath(),
		], cwd=bld.srcnode.abspath())

	bld(
		name = 'rust_engine_workspace',
		rule = run_cargo,
		source = sources,
		target = outputs,
		always = False,
	)
	if modules:
		for name in RUST_LINKED_MODULES:
			bld(name = name, features = 'cargo_link_library')
	bld.install_files(bld.env.LIBDIR, [abi] + modules, chmod=Utils.O755)
	if launcher:
		bld.install_as(os.path.join(bld.env.BINDIR, 'hl2_launcher'),
			launcher, chmod=Utils.O755)
