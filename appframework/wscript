def configure(conf):
	return

def build(bld):
	source = [
		'AppSystemGroup.cpp',
		'../public/filesystem_init.cpp',
	]

	if bld.env.SDL:
		source += [
			'sdlmgr.cpp'
		]

	if bld.env.DEST_OS == 'darwin' and bld.env.GL:
		source += ['glmrendererinfo_osx.mm']


	if bld.env.DEST_OS == 'win32':
		source += [
			'vguimatsysapp.cpp',
			'winapp.cpp'
		]
	else:
		source += [
			'posixapp.cpp',#		[$POSIX]
		]

	includes = [
		'.',
		'../public',
		'../public/tier0',
		'../public/tier1'
	] + bld.env.INCLUDES_SDL2

	defines = []

	libs = []
	if bld.env.RUST_ENGINE:
		defines += ['SOURCE_RUST_ENGINE=1']

	if bld.env.DEST_OS == 'darwin':
		libs += ['FOUNDATION', 'APPKIT', 'IOKIT']

	bld.stlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		defines  = defines,
		use      = libs,
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx      = bld.get_taskgen_count()
	)

	if bld.env.RUST_ENGINE:
		static_name = 'source_abi.lib' if bld.env.DEST_OS == 'win32' else 'libsource_abi.a'
		rust_static = bld.bldnode.make_node('cargo-target/release/' + static_name)
		rust_linkflags = []
		if bld.env.DEST_OS == 'darwin':
			rust_linkflags += ['-Wl,-install_name,@loader_path/librust_engine_bridge.dylib']
		bld.shlib(
			source   = ['rust_engine_bridge.cpp'],
			target   = 'rust_engine_bridge',
			name     = 'rust_engine_bridge',
			features = 'c cxx rust_static_link',
			includes = includes,
			defines  = ['SOURCE_RUST_BRIDGE_BUILD=1'],
			linkflags = rust_linkflags,
			install_path = bld.env.LIBDIR,
			rust_static_library = rust_static,
			subsystem = bld.env.MSVC_SUBSYSTEM,
			idx      = bld.get_taskgen_count()
		)
