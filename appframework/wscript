from waflib import Utils
from waflib.TaskGen import feature, after_method
import os

top = '.'
PROJECT_NAME = 'appframework'

@feature('rust_static_link')
@after_method('apply_link')
def add_rust_static_library(self):
	# Treat Cargo's static library as a first-class linker input. Sharing the
	# exact output node with the Cargo task gives Waf its content dependency.
	# Explicitly post and order the producer as well so a targeted launcher build
	# works from a clean tree rather than only as part of the default build.
	cargo = self.bld.get_tgen_by_name('rust_engine_workspace')
	cargo.post()
	for task in cargo.tasks:
		self.link_task.run_after.add(task)
	self.link_task.inputs.append(self.rust_static_library)

